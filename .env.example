# All of these can also be set as plain environment variables (e.g. panel
# secrets on a bot host) instead of using this file — the file is optional.

DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash command sync to a single guild for instant updates
# Leave empty to sync globally (can take up to an hour to propagate)
GUILD_ID=

# Optional: default CS2 server. /scrimconfig server (per guild) overrides these.
SERVER_HOST=
SERVER_PORT=27015
SERVER_PASSWORD=
RCON_PASSWORD=

# Web admin panel. Set PANEL_PASSWORD to enable it; leave empty to disable.
# On bot-hosting.net set WEB_PORT to your server's allocated port.
PANEL_PASSWORD=
WEB_PORT=
WEB_HOST=0.0.0.0
